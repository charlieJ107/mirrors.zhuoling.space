# Copy to .dev.vars for local development (used by wrangler dev).
# For production, set these as Worker Secrets in the Cloudflare dashboard.

# A random 32+ character string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-plus-character-random-secret

# Base URL of the app. Use localhost for dev, production URL for prod.
BETTER_AUTH_URL=http://localhost:8787

BETTER_AUTH_ALLOWED_HOSTS=""

# Required only for the Node deployment target.
DATABASE_URL=postgres://user:password@localhost:5432/app

# Optional for Node deployment. Defaults to 3000.
PORT=3000
