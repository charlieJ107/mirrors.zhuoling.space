{
  "name": "cf-react-hono-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run start:node",
    "build": "npm run build:cf",
    "build:cf": "tsc -b && vite build",
    "build:node": "tsc -b && vite build --config vite.config.client.ts && vite build --config vite.config.node.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "start:node": "node dist/node/entry.node.js",
    "docker:build": "docker build -t cf-react-hono-template-node .",
    "docker:run": "docker run --rm --env-file .env -p 3000:3000 cf-react-hono-template-node",
    "auth:generate": "npx auth@latest generate --config better-auth.config.ts --output ./schema.sql --yes",
    "db:migrate:d1:local": "wrangler d1 migrations apply cf-react-hono-template --local",
    "db:migrate:d1:remote": "wrangler d1 migrations apply cf-react-hono-template --remote",
    "db:migrate:postgres:latest": "kysely migrate latest",
    "db:migrate:postgres:up": "kysely migrate up",
    "db:migrate:postgres:down": "kysely migrate down",
    "db:migrate:postgres:status": "kysely migrate list",
    "cf-typegen": "wrangler types",
    "deploy": "npm run deploy:cf",
    "deploy:cf": "npm run build:cf && wrangler deploy",
    "check": "tsc -b && npm run build:cf && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "kysely": "^0.29.6",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.2",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "kysely-ctl": "^0.21.0",
    "shadcn": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.2"
  }
}
